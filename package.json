{
  "name": "hearken-site",
  "private": true,
  "type": "module",
  "description": "The Hearken Studio website",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node build.mjs",
    "build:offline": "node build.mjs --offline",
    "dev": "node build.mjs && node scripts/serve.mjs",
    "test": "node --test test/api.test.mjs test/auth.test.mjs test/account.test.mjs test/admin.test.mjs",
    "licence": "node --env-file-if-exists=.env.local scripts/issue-licence.mjs"
  }
}
